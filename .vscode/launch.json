    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "Master: STM32 Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "serverSerialNumber": "37FF71064E573436BE941A43",
            "serverPort": "61234",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": "4"
            }
        },
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "Slave: STM32 Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "serverSerialNumber": "37FF71064E57343602A91A43",
            "serverPort": "61235",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ],
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": "4"
            }
        }
    ]
}